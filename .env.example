# Shankar Jewellery ERP - Supabase Environment Configuration
# Copy this file to .env or set these environment variables in your deployment platform (Vercel, Netlify, Cloudflare, etc.)

# Your Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Public API Key
VITE_SUPABASE_ANON_KEY=your-actual-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-actual-supabase-anon-key
